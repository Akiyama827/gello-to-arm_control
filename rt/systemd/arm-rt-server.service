# The RT machine's whole job, as a unit. Install:
#   sudo cp arm-rt-server.service /etc/systemd/system/
#   sudo systemctl enable --now arm-rt-server
# The server is an APPLIANCE: it outlives PC-side graph restarts, holds the
# arm through faults, and never needs the PC to be healthy to be safe.
[Unit]
Description=arm_rt_server — 1 kHz torque servo (RT link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path and backend for the box (franka on the bench RT machine).
# --rt-cpu pins ONLY the servo thread to an isolcpus core; do NOT add a
# CPUAffinity= line — pinning the whole process would put the SCHED_OTHER
# comms threads on the servo core, where a preempted seqlock writer competes
# with the FIFO reader for the same cycles.
# --bind: answer ONLY on the PC direct link — the box is dual-NIC and the
# default INADDR_ANY would take commands from the robot LAN too.
ExecStart=/opt/arm_rt/arm_rt_server --backend franka --franka-ip 172.16.0.3 --rt-cpu 3 --bind 172.16.1.2
# always, not on-failure: an appliance must come back from EVERY exit —
# including the deliberate clean exit the server now makes after 5 s of
# unreachable plant (franka::Robot is built once; a control-box power cycle
# needs a fresh process). No start-limit: keep retrying while the plant
# is down rather than giving up after 5 attempts.
Restart=always
RestartSec=2
StartLimitIntervalSec=0
# RT scheduling + locked memory; pair with a PREEMPT_RT kernel and the
# limits documented in rt/README.md.
LimitMEMLOCK=infinity
# 99, not 95: libfranka's kEnforce requests the HIGHEST fifo priority (99)
# and refuses to start below it — confirmed live (95 ok, 99 EPERM = the
# "unable to set realtime scheduling" error).
LimitRTPRIO=99
Nice=-20

[Install]
WantedBy=multi-user.target
