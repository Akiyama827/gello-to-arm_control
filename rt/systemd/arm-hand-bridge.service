# Franka Hand daemon (rt/src/hand_bridge.cpp) — owns franka::Gripper on the
# box because the Hand server is SINGLE-CLIENT with newest-wins eviction: the
# one session must live where the arm's FCI session lives, and the PC gets a
# TCP re-export instead. Not RT; plain user service. Install:
#   sudo cp arm-hand-bridge.service /etc/systemd/system/
#   sudo systemctl enable --now arm-hand-bridge
[Unit]
Description=hand_bridge — Franka Hand TCP re-export for the PC
After=network-online.target
Wants=network-online.target
# in [Unit], not [Service] — the box's systemd ignores it there and the default
# 5-starts/10s limit races our 2s retry cycle
StartLimitIntervalSec=0

[Service]
Type=simple
User=ok
# args: <robot-ip> <port> <bind-ip>; bind to the PC direct link only.
ExecStart=/home/ok/arm_rt/hand_bridge 172.16.0.3 47802 172.16.1.2
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
