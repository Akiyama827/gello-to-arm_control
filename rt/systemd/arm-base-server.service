# Modular-base joint servo — a SECOND arm_rt_server instance on the same box,
# --backend dm: 2 DM joint motors in MIT torque mode over the shared FDCAN bus
# (gs_usb can0), own ports 47810/47811 so the PC stack talks to it with the
# unmodified rt_interface.py contract.
#
#   sudo cp arm-base-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start arm-base-server        # NOT `enable --now` — see below
#
# ---------------------------------------------------------------------------
# WHY THIS UNIT IS NOT AN APPLIANCE (unlike arm-rt-server.service)
# ---------------------------------------------------------------------------
# The FR3 unit may `enable` and `Restart=always` forever because the FR3 has its
# own safety controller underneath: joint limits, velocity envelopes, collision
# reflexes, a brake. If its server thrashes, the ARM is still protected.
#
# This plant has NONE of that. We drive two DM motors directly in torque mode;
# the only thing between a bad number and the hardware is this process. So:
#
#   * DO NOT `systemctl enable` it. Motors must not go live at boot with nobody
#     at the bench. Start it deliberately, when someone is present.
#   * Restart is on-failure with a real start limit, not always-forever. Every
#     restart re-sends the DM enable frame and leaves the joints LIMP until a
#     client arms (backend_dm.cpp: enable on first read, zero torque until
#     ARMED). Stiction holds the base at rest, but vibration breaks it loose —
#     a base carrying a module has fallen 83 deg from that window before.
#   * Gains are explicit, never inherited. hold_kp/hold_kd default to 50/5; the
#     defaults happen to be right, but a default that drifts is a silent change
#     in how hard this thing pushes.
#
# KNOWN GAP (needs a code change, not a unit change): rt_loop clamps torque to
# backend->tau_limit(), which for a DM4340 is the MOTOR's +/-28 N.m rating —
# above modular_base_2dof.urdf's own effort="22" and ~127x the 0.21 N.m this
# base needs to hold itself. There is no --tau-max flag yet. At hold_kp 50 a
# 0.56 rad (32 deg) position error saturates it. Until that flag exists, treat
# large commanded steps as the hazard they are.
# ---------------------------------------------------------------------------

[Unit]
Description=arm_rt_server — modular-base DM joints (500 Hz torque servo)
After=network-online.target can0-up.service
Wants=network-online.target can0-up.service
# Deliberate, bounded restart budget: 3 failures in 60 s and it STAYS down for a
# human to look at. Contrast arm-rt-server, which sets StartLimitIntervalSec=0
# to knock forever — right for a plant with its own safety layer, wrong here.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ok
# --dm-spec: iface;id:type[:mst]. GENERATED FROM configs/real/base/hardware.yaml
# via dm_spec_from_config() — do not hand-edit; edit the config and re-derive.
# scripts/check_dm_spec.py asserts this literal still matches that config.
# The :0x11/:0x12 Master IDs are NOT optional: the backend installs a kernel CAN
# filter on them (backend_dm.cpp:240), so the factory-default 0x00 silently
# drops every reply and reports "motor N never replied".
# --rt-cpu 1: the box isolates cpus 1 and 3. cpu 3 is the FR3 servo's; 1 is free
# and isolated, so this loop gets a quiet core instead of floating on
# housekeeping cpus 0/2.
# --bind: answer ONLY on the router/PC link — the box is dual-homed and the
# default INADDR_ANY would take commands from the robot LAN too.
ExecStart=/home/ok/arm_rt/arm_rt_server --backend dm \
    --dm-spec "can0;0x01:4340:0x11,0x02:4340p:0x12" \
    --udp-port 47810 --tcp-port 47811 --bind 172.16.1.2 \
    --rt-cpu 1 --hold-kp 50 --hold-kd 5
# on-failure, not always: a clean exit (the deliberate one after 5 s of silent
# bus — adapter replugged, base unpowered) means the hardware is not there, and
# re-enabling motors into an absent bus every 2 s helps nobody. A human plugs it
# back in and starts the unit.
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitRTPRIO=99
Nice=-20

# Deliberately NO [Install] section: this unit cannot be `systemctl enable`d.
# Removing that footgun is the point — see the header.
