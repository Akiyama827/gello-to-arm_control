# Dock latch/sensor daemon (rt/src/dock_bridge.cpp) — re-exports the
# Dock_Control CAN verbs (LATCH/UNLATCH/STATE/SENSE/SCAN) as a TCP line
# protocol for the PC. Shares can0 with arm-base-server via disjoint kernel
# CAN filters (docks reply on 0xF0-0xFF, motors on their Master ID). Not RT;
# plain user service, NO deadman on purpose: the latch changes state only on
# explicit verbs, and on client loss it does nothing. Install:
#   sudo cp arm-dock-bridge.service /etc/systemd/system/
#   sudo systemctl enable --now arm-dock-bridge
[Unit]
Description=dock_bridge — dock latch/sensor TCP re-export for the PC
After=network-online.target can0-up.service
Wants=network-online.target can0-up.service
# in [Unit], not [Service] — the box's systemd ignores it there and the default
# 5-starts/10s limit races our 2s retry cycle
StartLimitIntervalSec=0

[Service]
Type=simple
User=ok
# The box needs the gs_usb link up first (can0-up.service does
# `ip link set can0 up type can bitrate 1000000 dbitrate 4000000 fd on`).
# args: <can-if> <port> <bind-ip>; bind to the PC direct link only.
ExecStart=/home/ok/arm_rt/dock_bridge can0 47803 172.16.1.2
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
